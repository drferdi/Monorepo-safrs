{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safrs:operation-contract.v1",
  "title": "OperationContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "adapter_id",
    "task_id",
    "contract_digest",
    "subject_sha",
    "target_environment",
    "parameters",
    "parameters_digest",
    "operation_digest",
    "dry_run_artifact_digest",
    "preconditions",
    "postconditions",
    "idempotency_key",
    "rollback_contract_id",
    "requested_at",
    "expires_at",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "operation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "adapter_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]{8}-[A-Z0-9-]+$" },
    "contract_digest": { "$ref": "#/$defs/sha256" },
    "subject_sha": { "$ref": "#/$defs/gitSha" },
    "target_environment": { "type": "string", "minLength": 1 },
    "parameters": { "type": "object" },
    "parameters_digest": { "$ref": "#/$defs/sha256" },
    "operation_digest": { "$ref": "#/$defs/sha256" },
    "dry_run_artifact_digest": { "$ref": "#/$defs/sha256" },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "rollback_contract_id": { "type": "string", "minLength": 1 },
    "requested_at": { "$ref": "#/$defs/utcTimestamp" },
    "expires_at": { "$ref": "#/$defs/utcTimestamp" },
    "status": {
      "enum": [
        "PREPARED",
        "PENDING_APPROVAL",
        "APPROVED",
        "EXECUTED",
        "STOPPED",
        "EXPIRED",
        "ROLLED_BACK"
      ]
    }
  },
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
