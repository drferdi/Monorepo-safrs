{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safrs:platform-attestation.v1",
  "title": "PlatformAttestationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "default_branch",
    "observed_at",
    "observer_identity",
    "ruleset_digest",
    "required_checks",
    "code_owner_review",
    "stale_review_dismissal",
    "force_push_blocked",
    "bypass_actors",
    "secret_scanning",
    "push_protection",
    "dependency_graph",
    "dependabot_alerts",
    "code_scanning",
    "negative_test_evidence",
    "expires_at",
    "attestation_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "observer_identity": {
      "type": "string",
      "minLength": 1
    },
    "ruleset_digest": {
      "$ref": "#/$defs/sha256"
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "code_owner_review": {
      "type": "boolean"
    },
    "stale_review_dismissal": {
      "type": "boolean"
    },
    "force_push_blocked": {
      "type": "boolean"
    },
    "bypass_actors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "secret_scanning": {
      "type": "boolean"
    },
    "push_protection": {
      "type": "boolean"
    },
    "dependency_graph": {
      "type": "boolean"
    },
    "dependabot_alerts": {
      "type": "boolean"
    },
    "code_scanning": {
      "type": "boolean"
    },
    "negative_test_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expires_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "attestation_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
      "format": "date-time"
    }
  }
}
