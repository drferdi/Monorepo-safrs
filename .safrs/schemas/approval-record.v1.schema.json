{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safrs:approval-record.v1",
  "title": "ApprovalRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "kind",
    "task_id",
    "contract_digest",
    "subject_sha",
    "diff_digest",
    "operation_digest",
    "target_environment",
    "idempotency_key",
    "reviewer_identity",
    "reviewer_authority",
    "author_identity",
    "issued_at",
    "expires_at",
    "source_event_url",
    "source_event_id",
    "revoked_at",
    "approval_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "R2_CODE_OWNER",
        "R2_INDEPENDENT",
        "VERIFICATION_INTEGRITY",
        "R3_EXECUTION"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{8}-[A-Z0-9-]+$"
    },
    "contract_digest": {
      "$ref": "#/$defs/sha256"
    },
    "subject_sha": {
      "$ref": "#/$defs/gitSha"
    },
    "diff_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": null
        }
      ]
    },
    "operation_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": null
        }
      ]
    },
    "target_environment": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "const": null
        }
      ]
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "const": null
        }
      ]
    },
    "reviewer_identity": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_authority": {
      "type": "string",
      "minLength": 1
    },
    "author_identity": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "source_event_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1
    },
    "revoked_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/utcTimestamp"
        },
        {
          "const": null
        }
      ]
    },
    "approval_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "R2_CODE_OWNER",
              "R2_INDEPENDENT"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "diff_digest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "R3_EXECUTION"
          }
        }
      },
      "then": {
        "properties": {
          "operation_digest": {
            "$ref": "#/$defs/sha256"
          },
          "target_environment": {
            "type": "string",
            "minLength": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?Z$",
      "format": "date-time"
    }
  }
}
