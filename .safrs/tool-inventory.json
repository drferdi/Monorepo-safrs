{
  "version": 1,
  "default_network_policy": "deny-unless-task-authorized",
  "tools": [
    {
      "id": "local-filesystem",
      "owner": "repository-maintainers",
      "purpose": "Scoped repository inspection and mutation",
      "allowed_operations": ["read", "search", "modify-scoped"],
      "data_scope": "repository-only",
      "authentication": "os-user",
      "network_endpoints": [],
      "provenance": "host-operating-system",
      "review_status": "APPROVED"
    },
    {
      "id": "git",
      "owner": "repository-maintainers",
      "purpose": "Local version control, diff, branches, and review evidence",
      "allowed_operations": ["status", "diff", "add", "commit", "branch", "worktree"],
      "data_scope": "repository-only",
      "authentication": "none-for-local-operations",
      "network_endpoints": [],
      "provenance": "system-installation",
      "review_status": "APPROVED"
    },
    {
      "id": "python3",
      "owner": "repository-maintainers",
      "purpose": "Run deterministic SAFRS checks and repository tests",
      "allowed_operations": ["execute-repository-checks", "execute-tests"],
      "data_scope": "repository-only",
      "authentication": "none",
      "network_endpoints": [],
      "provenance": "system-installation",
      "review_status": "APPROVED"
    },
    {
      "id": "bash",
      "owner": "repository-maintainers",
      "purpose": "Run the canonical local verification entry point",
      "allowed_operations": ["execute-repository-scripts"],
      "data_scope": "repository-only",
      "authentication": "none",
      "network_endpoints": [],
      "provenance": "system-installation",
      "review_status": "APPROVED"
    },
    {
      "id": "github-actions-checkout",
      "owner": "repository-maintainers",
      "purpose": "Read repository content in SAFRS Governance CI",
      "allowed_operations": ["checkout-read-only"],
      "data_scope": "repository-only",
      "authentication": "github-actions-token-with-contents-read",
      "network_endpoints": ["github.com", "api.github.com"],
      "provenance": "actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8",
      "review_status": "APPROVED"
    },
    {
      "id": "pnpm-npm-registry",
      "owner": "repository-maintainers",
      "purpose": "Install exact lockfile dependencies and run approved workspace commands",
      "allowed_operations": ["frozen-install", "run-declared-scripts"],
      "data_scope": "public-package-metadata-and-repository-workspace",
      "authentication": "none",
      "network_endpoints": ["registry.npmjs.org"],
      "provenance": "pnpm-lock.yaml and package.json",
      "review_status": "APPROVED"
    },
    {
      "id": "docker-local-postgres",
      "owner": "repository-maintainers",
      "purpose": "Run the isolated local PostgreSQL service used by setup and tests",
      "allowed_operations": ["start-local-service", "stop-local-service", "pull-declared-image"],
      "data_scope": "local-development-data-only",
      "authentication": "none",
      "network_endpoints": ["registry-1.docker.io"],
      "provenance": "compose.yaml",
      "review_status": "APPROVED"
    },
    {
      "id": "playwright-local-browser",
      "owner": "repository-maintainers",
      "purpose": "Exercise the local golden-path browser journey",
      "allowed_operations": ["run-local-browser-tests"],
      "data_scope": "localhost-test-application-only",
      "authentication": "none",
      "network_endpoints": ["127.0.0.1"],
      "provenance": "@playwright/test in pnpm-lock.yaml",
      "review_status": "APPROVED"
    },
    {
      "id": "github-actions-ci",
      "owner": "repository-maintainers",
      "purpose": "Run non-deploying pull-request verification with immutable action references",
      "allowed_operations": ["checkout-read-only", "run-ci-verification", "upload-test-artifacts"],
      "data_scope": "repository-and-non-secret-test-data",
      "authentication": "github-actions-ephemeral-token-with-contents-read",
      "network_endpoints": ["github.com", "api.github.com", "registry.npmjs.org", "registry-1.docker.io"],
      "provenance": ".github/workflows/ci.yml",
      "review_status": "APPROVED"
    },
    {
      "id": "renovate-pr-automation",
      "owner": "repository-maintainers",
      "purpose": "Create reviewable dependency-update pull requests without auto-merge or deployment authority",
      "allowed_operations": ["read-dependency-metadata", "update-lockfiles-in-pull-request", "create-pull-request"],
      "data_scope": "repository-dependency-manifests-lockfiles-and-public-package-metadata",
      "authentication": "repository-scoped-renovate-app-or-bot-token",
      "network_endpoints": ["github.com", "api.github.com", "registry.npmjs.org"],
      "provenance": ".github/renovate.json",
      "activation_status": "PR_ONLY",
      "review_status": "APPROVED"
    },
    {
      "id": "context7-mcp",
      "owner": "repository-maintainers",
      "purpose": "Read current public library documentation for repository development",
      "allowed_operations": ["resolve-public-library", "read-public-library-documentation"],
      "data_scope": "public-library-identifiers-and-task-scoped-documentation-queries-only",
      "authentication": "none",
      "network_endpoints": ["registry.npmjs.org", "mcp.context7.com"],
      "provenance": "@upstash/context7-mcp@4.0.0 via pnpm dlx (.codex/config.toml); @upstash/context7-mcp@4.0.2 via npx (.cursor/mcp.json)",
      "review_status": "APPROVED"
    },
    {
      "id": "playwright-mcp",
      "owner": "repository-maintainers",
      "purpose": "Browser automation assist for local UI verification via MCP",
      "allowed_operations": ["navigate", "snapshot", "interact-local-pages"],
      "data_scope": "task-scoped-browser-targets-prefer-localhost",
      "authentication": "none",
      "network_endpoints": ["registry.npmjs.org"],
      "provenance": "@playwright/mcp@0.0.79 via npx (.cursor/mcp.json)",
      "review_status": "APPROVED"
    },
    {
      "id": "firecrawl-mcp",
      "owner": "repository-maintainers",
      "purpose": "Web scrape and search for SOTA/docs research; output is untrusted data",
      "allowed_operations": ["scrape", "search", "map", "extract"],
      "data_scope": "public-web-content-task-scoped",
      "authentication": "FIRECRAWL_API_KEY from user environment",
      "network_endpoints": ["registry.npmjs.org", "api.firecrawl.dev"],
      "provenance": ".cursor/mcp.json → firecrawl-mcp via npx; env FIRECRAWL_API_KEY",
      "review_status": "APPROVED"
    },
    {
      "id": "sequential-thinking-mcp",
      "owner": "repository-maintainers",
      "purpose": "Structured multi-step reasoning assist for complex local tasks",
      "allowed_operations": ["sequential-think"],
      "data_scope": "in-session-reasoning-only",
      "authentication": "none",
      "network_endpoints": ["registry.npmjs.org"],
      "provenance": ".cursor/mcp.json → @modelcontextprotocol/server-sequential-thinking via npx",
      "review_status": "APPROVED"
    },
    {
      "id": "filesystem-mcp",
      "owner": "repository-maintainers",
      "purpose": "Scoped filesystem tools under D:/DEV for monorepo agent workflows",
      "allowed_operations": ["read", "list", "search", "write-scoped"],
      "data_scope": "D:/DEV only as configured in .cursor/mcp.json",
      "authentication": "os-user",
      "network_endpoints": ["registry.npmjs.org"],
      "provenance": ".cursor/mcp.json → @modelcontextprotocol/server-filesystem with D:/DEV root",
      "review_status": "APPROVED"
    },
    {
      "id": "deps-graph",
      "owner": "repository-maintainers",
      "purpose": "Render the monorepo inter-package dependency graph (read-only, manual/CI-optional aid)",
      "allowed_operations": ["read-workspace-manifests", "render-graph"],
      "data_scope": "repository-only",
      "authentication": "none",
      "network_endpoints": [],
      "provenance": "tools/deps-graph/src/cli.mjs",
      "review_status": "APPROVED"
    },
    {
      "id": "jaeger-otlp-collector",
      "owner": "repository-maintainers",
      "purpose": "Local OpenTelemetry trace collector (Jaeger all-in-one) for dev-time distributed tracing",
      "allowed_operations": ["read-local-traces", "serve-local-ui"],
      "data_scope": "local-development-traces-only",
      "authentication": "none",
      "network_endpoints": ["127.0.0.1:16686", "127.0.0.1:4317", "127.0.0.1:4318"],
      "provenance": "compose.telemetry.yaml → jaegertracing/all-in-one:1.62",
      "review_status": "APPROVED"
    }
  ]
}
