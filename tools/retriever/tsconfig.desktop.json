{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "./dist-electron",
    "lib": ["DOM", "ES2022"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": [
    "desktop/**/*"
  ],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
