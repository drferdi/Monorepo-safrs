{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "ignorePatterns": [
    // Standalone capsule with its own package.json. The root pnpm workspace
    // excludes projects/healthcare, so a root fallow run would treat
    // @ai-sdk/google (already declared in the capsule) as a root dependency.
    "projects/healthcare/assistverse/**"
  ],
  "workspaces": {
    "patterns": [
      "projects/*/*/apps/*",
      "!projects/academic/academic-smartboard/**",
      "!projects/product/kediri-history/**",
      "!projects/product/sentrabot/**",
      "!projects/internal/golden-path/**",
      "!projects/healthcare/**",
      "packages/*",
      "tools/*",
      "!tools/retriever",
      "!tools/prompt/**"
    ]
  },
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreExports": [
    {
      "file": "projects/healthcare/referralink/api/_types/sandbox-auth.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/referralink/services/authService.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/iskandar-diagnosis-engine/engine.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/types/api.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/diagnosis-engine/types.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/iskandar-diagnosis-engine/triage-referral-decision-tree.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/filler/filler-core.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/utils/types.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/sentraverse-neural/components/neural/morph.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/sentraverse-neural/components/neural/timeline.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/scraper/adaptive/types.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/medboard/src/lib/clinical/trajectory-analyzer.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/medboard/src/lib/occult-shock-detector.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/components/clinical/TTVInferenceUI.tsx",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/clinical/vital-guardrails.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/medboard/src/lib/cdss/types.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/medboard/src/types/abyss/clinical.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/api/auth-client.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/api/auth-store.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/diagnosis-engine/testing/memory-icd10-db.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/med-assist/lib/rag/icd10-db.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/medboard/src/app/api/sentrapedia/contributions/[id]/route.ts",
      "exports": ["*"]
    },
    {
      "file": "projects/healthcare/medboard/src/app/api/sentrapedia/contributions/route.ts",
      "exports": ["*"]
    }
  ]
}
