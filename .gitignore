# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# JavaScript and build output
node_modules/
dist/
build/
coverage/
.next/
.turbo/
playwright-report/
test-results/
test-report/
verify-report/
*.tsbuildinfo
pnpm-debug.log*
debug-*.log

# Sentra Library: quarantine heavy media and confidential legal/financial records
docs/library/**/*.mp4
docs/library/**/*.zip
docs/library/01_CORPORATE_LEGAL/01_Incorporation/
docs/library/01_CORPORATE_LEGAL/02_Agreements_Under_Review/
docs/library/03_FINANCE_STRATEGY/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
.superpowers
.sentra-gsap
.kilo/
.kilo-trash/

# Internal agent workflows, plans, progress, notes, and superpowers
docs/plans/
docs/superpowers/
docs/gaffer_note/
docs/workflow/
**/docs/superpowers/
projects/**/.claude/
projects/**/.cursor/

# Ephemeral agent caches and memories
**/.claude/agent-memory/
**/.cursor/hooks/state/

.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
.cursor/hooks/state/
!.cursor/mcp.json
!.cursor/skills/
!.cursor/skills/**
!.cursor/agents/
!.cursor/agents/**

# Local Claude Code state; shared settings, hooks, agents, and skills are tracked
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/commands/
!.claude/commands/**
.claude/settings.local.json

# Local Codex state; shared project config, hooks, agents, and skills are tracked
.codex/*
!.codex/config.toml
!.codex/hooks.json
!.codex/hooks/
!.codex/hooks/**
!.codex/agents/
!.codex/agents/**

.worktrees/
.pnpm-store/

# Database corpus — keep directories, ignore content
# Medical guideline docs (large JSON files) are not tracked in git.
database/canonical/*.json
database/canonical/*.jsonl
database/artifacts/
database/sources/
database/inbox/
database/logs/
database/state/

# Keep database README and directory structure
!database/README.md
!database/canonical/.gitkeep
!database/artifacts/.gitkeep
!database/sources/.gitkeep
!database/inbox/.gitkeep
!database/logs/.gitkeep
!database/state/.gitkeep

# SpecStory session state — local tool state, not repo content
.specstory/cli/
.specstory/history/

# Next.js dev-server generated local agent files
projects/*/apps/*/AGENTS.md
projects/*/apps/*/CLAUDE.md
