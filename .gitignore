# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# JavaScript and build output
node_modules/
dist/
build/
coverage/
.next/
.turbo/
playwright-report/
test-results/
*.tsbuildinfo
pnpm-debug.log*
debug-*.log

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
.superpowers
# Local Cursor state; shared Project Rules / hooks / MCP / skills / agents are tracked
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
!.cursor/mcp.json
!.cursor/skills/
!.cursor/skills/**
!.cursor/agents/
!.cursor/agents/**

# Local Claude Code state; shared settings, hooks, agents, and skills are tracked
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
.claude/settings.local.json

# Local Codex state; shared project config, hooks, agents, and skills are tracked
.codex/*
!.codex/config.toml
!.codex/hooks.json
!.codex/hooks/
!.codex/hooks/**
!.codex/agents/
!.codex/agents/**

.worktrees/
.pnpm-store/

# Database corpus — keep directories, ignore content
# Medical guideline docs (large JSON files) are not tracked in git.
database/canonical/*.json
database/canonical/*.jsonl
database/artifacts/
database/sources/
database/inbox/
database/logs/
database/state/

# Keep database README and directory structure
!database/README.md
!database/canonical/.gitkeep
!database/artifacts/.gitkeep
!database/sources/.gitkeep
!database/inbox/.gitkeep
!database/logs/.gitkeep
!database/state/.gitkeep

# SpecStory session state — local tool state, not repo content
.specstory/cli/
.specstory/history/

# Next.js dev-server generated local agent files
projects/*/apps/*/AGENTS.md
projects/*/apps/*/CLAUDE.md
