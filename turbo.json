{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "APP_URL",
        "NEXT_PUBLIC_BACKEND_URL",
        "NEXT_PUBLIC_DEV_TENANT_SLUG",
        "NODE_ENV"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**",
        "out/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false,
      "env": ["DATABASE_URL", "APP_URL", "NODE_ENV"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "APP_URL",
        "NEXT_PUBLIC_BACKEND_URL",
        "NEXT_PUBLIC_DEV_TENANT_SLUG",
        "NODE_ENV"
      ]
    }
  }
}
