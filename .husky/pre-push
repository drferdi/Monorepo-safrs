#!/bin/sh
# PUBLISH GATE (Chief, 2026-08-24) — .agents/BOUNDARIES.md, ditegakkan oleh mesin.
# Push diblokir untuk SEMUA agen/sesi kecuali Chief menyetujui run ini dengan:
#   CHIEF_PUSH_OK=1 git push ...
# Riwayat repo memuat nomor telepon/JID asli (pra-f1aeb75); insiden publikasi
# 2026-08-24 ~01:12. Jangan hapus/lemahkan hook ini (AGENTS.md rule 6).

if [ "$CHIEF_PUSH_OK" != "1" ]; then
  echo "==================================================================" >&2
  echo " PUSH DIBLOKIR — publish gate (.agents/BOUNDARIES.md)" >&2
  echo " Push apa pun butuh persetujuan eksplisit Chief pada run ini:" >&2
  echo "   CHIEF_PUSH_OK=1 git push ..." >&2
  echo " Riwayat memuat nomor/JID asli; publikasi = keputusan Chief." >&2
  echo "==================================================================" >&2
  exit 1
fi

# Persetujuan diberikan: pemindaian sanitasi pada rentang yang akan dipush.
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  hits=$(git log --pretty=format: --patch "$range" 2>/dev/null | grep -cE '^\+.*([0-9]{10,}@(g\.us|lid|s\.whatsapp\.net)|\b628[0-9]{8,11}\b)')
  if [ "$hits" -gt 0 ] 2>/dev/null; then
    echo "PUSH DIBLOKIR: $hits baris baru berpola nomor/JID di $range." >&2
    echo "Redaksi dulu, atau (hanya atas perintah Chief) CHIEF_PUSH_FORCE=1." >&2
    fail=1
  fi
done
[ "$fail" = "1" ] && [ "$CHIEF_PUSH_FORCE" != "1" ] && exit 1
exit 0
