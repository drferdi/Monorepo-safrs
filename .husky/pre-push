#!/usr/bin/env sh
# Publish gate (Chief, 2026-08-24; diperbarui Gaffer 2026-10-13): riwayat
# lokal memuat nomor/JID asli. Hook memeriksa commit yang benar-benar keluar
# (yang belum ada di remote tujuan). Push bersih — tanpa projects/** dan tanpa
# pola nomor/JID di baris yang ditambahkan — lolos tanpa variabel apa pun.
# Push yang membawa pola nomor/JID tetap butuh keputusan Chief:
#   CHIEF_PUSH_OK=1 git push ...
#
# Capsule gate (Chief, 2026-08-25): isi projects/ (kode capsule) tidak boleh
# dipublikasikan lewat remote monorepo; pengecualian sadar:
#   CHIEF_PUSH_PROJECTS_OK=1 CHIEF_PUSH_OK=1 git push ...

remote="$1"
zero=0000000000000000000000000000000000000000
jid='[0-9]{8,15}@(s\.whatsapp\.net|g\.us|c\.us)'
phone='(^|[^0-9A-Za-z])(\+?62|0)8[0-9]{8,11}([^0-9A-Za-z]|$)'

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per baris.
# Dibaca sekali karena kedua gate dan Git LFS sama-sama membutuhkannya.
refs=$(cat)
touched=""
pii=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue # penghapusan ref: tidak membawa isi
  # Commit keluar = yang belum dimiliki ref remote tujuan mana pun. Tanpa ref
  # remote-tracking, seluruh riwayat dihitung keluar (fail closed).
  [ -z "$touched" ] && touched=$(git rev-list "$local_sha" --not --remotes="$remote" -- projects/ 2>/dev/null | head -1)
  if [ -z "$pii" ] && git log -p --format= "$local_sha" --not --remotes="$remote" 2>/dev/null | grep -E '^\+' | grep -qE "$jid|$phone"; then
    pii=1
  fi
done <<EOF
$refs
EOF

if [ "${CHIEF_PUSH_OK:-0}" != "1" ] && [ -n "$pii$touched" ]; then
  echo "PUSH DIBLOKIR (publish gate): commit keluar membawa pola nomor/JID atau projects/**." >&2
  echo "Jalur bersih: branch dari origin/main berisi file yang berubah saja (.agents/DECISIONS.md, 2026-10-13)." >&2
  echo "Keputusan Chief untuk tetap publikasi: CHIEF_PUSH_OK=1 git push ..." >&2
  exit 1
fi

if [ -n "$touched" ] && [ "${CHIEF_PUSH_PROJECTS_OK:-0}" != "1" ]; then
  echo "PUSH DIBLOKIR (capsule gate): range keluar menyentuh projects/** (mis. commit $touched)." >&2
  echo "Kode capsule tidak dipublikasikan lewat remote monorepo (perintah Chief 2026-08-25)." >&2
  echo "Pengecualian sadar: CHIEF_PUSH_PROJECTS_OK=1 CHIEF_PUSH_OK=1 git push ..." >&2
  exit 1
fi

# Git LFS: core.hooksPath menunjuk ke husky, jadi hook pre-push milik LFS
# tidak pernah dipasang. Tanpa baris ini objek LFS tidak ikut ter-upload.
if ! command -v git-lfs >/dev/null 2>&1; then
  echo "PUSH DIBLOKIR: git-lfs tidak ditemukan, padahal repo ini memakai Git LFS." >&2
  exit 1
fi
printf '%s\n' "$refs" | git lfs pre-push "$@"
