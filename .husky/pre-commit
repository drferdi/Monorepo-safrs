#!/usr/bin/env sh
# Satu-satunya tugas hook ini: mencegah BAHAYA NYATA — kebocoran nomor
# telepon/JID asli ke riwayat git. Tidak ada gerbang gaya, tidak ada linter
# wajib, tidak ada blok "staged sebagian". (Chief, 2026-08-24: aturan proses
# tidak boleh menghambat manusia maupun model.)
# Redaksi (<ID>, 628xxxxxxxxxx) selalu lolos. Override sadar: CHIEF_PII_OK=1.

pii_hits="$(git diff --cached --unified=0 | grep -E '^[+][^+]' | grep -cE '([0-9]{10,}@(g[.]us|lid|s[.]whatsapp[.]net)|628[0-9]{8,11})' || true)"
if [ "${pii_hits:-0}" -gt 0 ] && [ "${CHIEF_PII_OK:-0}" != "1" ]; then
  echo "COMMIT DIBLOKIR: ${pii_hits} baris baru berpola nomor/JID asli." >&2
  echo "Redaksi dulu (628xxxxxxxxxx / <ID>@g.us), atau CHIEF_PII_OK=1 bila memang disengaja." >&2
  exit 1
fi
exit 0
