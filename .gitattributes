# Normalisasi akhir baris.
# Git menyimpan teks sebagai LF dan checkout juga LF di semua platform,
# supaya formatter (Biome lineEnding=lf) menghasilkan byte yang sama
# di Windows, macOS, dan runner Linux. Atribut eol di sini menang atas
# core.autocrlf, jadi tidak ada konfigurasi Git lokal yang perlu diseragamkan.
* text=auto eol=lf

# Skrip yang HARUS CRLF di Windows
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Skrip yang HARUS LF
*.sh   text eol=lf

# File biner - jangan disentuh sama sekali
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary

# Lockfile - biar diff-nya bersih
pnpm-lock.yaml text eol=lf -diff
