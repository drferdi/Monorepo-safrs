+def _local_outbound_safety_drop_reason(text):
+    """Fail-closed copy of avery_outbound.safety.drop_reason.
+
+    Keep in sync with projects/healthcare/avery/src/avery_outbound/safety.py.
+    """
+    if text is None:
+        return "EMPTY"
+    raw = str(text)
+    if not raw.strip():
+        return "EMPTY"
+    stripped = raw.strip()
+    separator_chars = set(" \t\r\n-_–—=*•·─━═~.|/\\")
+    if stripped and all(ch in separator_chars for ch in stripped):
+        return "SEPARATOR_ONLY"
+    checks = (
+        (re.compile(r"thinking-only\s+response", re.I), "THINKING_ONLY"),
+        (re.compile(r"empty\s+response\s+from\s+model", re.I), "EMPTY_MODEL"),
+        (re.compile(r"the model returned no response", re.I), "EMPTY_MODEL"),
+        (re.compile(r"\(\s*empty\s*\)", re.I), "EMPTY_MODEL"),
+        (re.compile(r"fallback\s+provider", re.I), "FALLBACK_PROVIDER"),
+        (re.compile(r"\bjob_id\b", re.I), "JOB_ID"),
+        (re.compile(r"cronjob response", re.I), "JOB_ID"),
+        (re.compile(r"to stop or manage this job", re.I), "JOB_ID"),
+        (re.compile(r"traceback", re.I), "TRACEBACK"),
+    )
+    for pattern, reason in checks:
+        if pattern.search(raw):
+            return reason
+    if re.search(
+        r"(?i)(\bretrying\b(\s+(in|with|once|from|after)|\.{2,}|…)"
+        r"|;\s*retrying\b"
+        r"|retrying\s+\()",
+        raw,
+    ):
+        return "RETRYING"
+    if re.search(
+        r"(?im)^(?:\s*(?:reading skill|searching files|updating memory|"
+        r"calling tool|using tool|running tool|tool result|tool_call|"
+        r"tool\.started|tool\.completed|tool\.failed)\b).*"
+        r"|^\s*\[[^\]]*tool[^\]]*\]",
+        raw,
+    ):
+        return "TOOL"
+    if re.search(
+        r"(?is)("
+        r"<\|im_start\|>|<\|im_end\|>|"
+        r"\[INST\]|<<SYS>>|"
+        r"you are \*?\*?avery|"
+        r"identification workflow|"
+        r"do not participate|"
+        r"require_mention|"
+        r"always execute this|"
+        r"system prompt|"
+        r"### (?:system|instruction)|"
+        r"soul\.md|"
+        r"skills_list|"
+        r"skill_view\("
+        r")",
+        raw,
+    ):
+        return "INTERNAL_INSTRUCTION"
+    return None
+
+
+def _outbound_safety_drop_reason(text):
+    """Prefer the capsule module; fall back to the local copy."""
+    try:
+        from avery_outbound.safety import drop_reason
+        return drop_reason(text)
+    except Exception:
+        pass
+    try:
+        from pathlib import Path as _Path
+        from hermes_constants import get_hermes_home
+        src = _Path(get_hermes_home()).resolve().parent.parent / "src"
+        safety_py = src / "avery_outbound" / "safety.py"
+        if safety_py.is_file():
+            import sys
+            src_s = str(src)
+            if src_s not in sys.path:
+                sys.path.insert(0, src_s)
+            from avery_outbound.safety import drop_reason
+            return drop_reason(text)
+    except Exception:
+        pass
+    return _local_outbound_safety_drop_reason(text)
+
+
