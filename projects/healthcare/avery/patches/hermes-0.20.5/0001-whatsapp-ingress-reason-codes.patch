+def _redact_jid(value) -> str:
+    """Redact a WhatsApp JID for logging: last 4 chars before '@' + domain.
+
+    Never returns the full identifier. E.g. ``6281234556112@g.us`` becomes
+    ``…6112@g.us``. Falls back to a fixed placeholder for empty/malformed
+    input so log lines never leak an unredacted value.
+    """
+    text = str(value or "")
+    if "@" in text:
+        local, _, domain = text.partition("@")
+        tail = local[-4:] if local else ""
+        return f"…{tail}@{domain}" if tail else f"…@{domain}"
+    tail = text[-4:] if text else ""
+    return f"…{tail}" if tail else "…"
+
