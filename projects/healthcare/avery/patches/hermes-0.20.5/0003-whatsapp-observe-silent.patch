+    def _observe_unmentioned_group_message(self, data: Dict[str, Any]) -> None:
+        """Persist allowlisted group text without invoking the model.
+
+        Baca tanpa balas: catat, jangan kirim. Gagal tulis tidak boleh
+        mengubah keputusan ingress.
+        """
+        try:
+            from datetime import datetime, timezone
+            from pathlib import Path as _Path
+
+            from hermes_constants import get_hermes_home
+
+            body = str(data.get("body") or "").strip()
+            if not body:
+                return
+            chat_id = str(data.get("chatId") or "")
+            sender = str(data.get("senderId") or data.get("from") or "")
+            rec = {
+                "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+                "chat_id": chat_id,
+                "sender": sender,
+                "text": body[:500],
+            }
+            path = _Path(get_hermes_home()) / "state" / "group-observe.jsonl"
+            path.parent.mkdir(parents=True, exist_ok=True)
+            with path.open("a", encoding="utf-8") as fh:
+                fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
+            max_lines = 2000
+            lines = path.read_text(encoding="utf-8").splitlines()
+            if len(lines) > max_lines:
+                path.write_text("\n".join(lines[-max_lines:]) + "\n", encoding="utf-8")
+        except Exception:
+            logger.debug("[%s] group observe write failed", self.name, exc_info=True)
+
