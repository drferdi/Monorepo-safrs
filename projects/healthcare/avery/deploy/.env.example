# Medisync — contoh variabel lingkungan
#
# Salin ke <HERMES_HOME>/profiles/avery/.env dan isi nilainya.
# Berkas .env yang sudah terisi JANGAN pernah di-commit.

# --- Penyedia model ---------------------------------------------------------
OPENROUTER_API_KEY=

# --- WhatsApp ---------------------------------------------------------------
WHATSAPP_ENABLED=true

# bot       — nomor terpisah khusus agen (yang dipakai Medisync).
# self-chat — agen hidup di chat-dengan-diri-sendiri milik pemilik nomor.
WHATSAPP_MODE=bot

# Nomor yang boleh memakai agen, dipisah koma, tanpa tanda plus.
# Bentuk telepon dan LID diperlakukan sama — pemetaannya dibaca dari direktori
# sesi. Kosong berarti TIDAK ADA yang diizinkan; "*" membuka untuk siapa saja.
WHATSAPP_ALLOWED_USERS=

# Awalan yang ditempelkan di depan setiap balasan. Kosongkan bila tidak perlu.
WHATSAPP_REPLY_PREFIX=

# Nilai legal: open | allowlist | disabled | pairing
#
# Nilai lain — termasuk "ignore" — tidak dikenal dan jatuh ke tolak-semua
# secara senyap. Untuk menolak DM tak dikenal tanpa membalas apa pun, biarkan
# ini "pairing" lalu setel `whatsapp.unauthorized_dm_behavior: ignore` di
# config.yaml; keduanya kunci yang berbeda dan mudah tertukar.
#
# PENTING: bridge Node melewatkan pesan grup hanya bila nilainya "pairing"
# (bridge.js memeriksa allowlist pengirim untuk nilai selain itu). Mengubahnya
# akan membuat pesan grup dibuang sebelum sampai ke gateway.
WHATSAPP_DM_POLICY=pairing

# Kanal tujuan hasil cron dan pesan lintas platform.
WHATSAPP_HOME_CHANNEL=

# Isi hanya bila kanal tujuan berupa forum/topik. Jangan biarkan kunci ini ada
# dengan nilai kosong — kosongnya diteruskan apa adanya ke subproses bridge.
# WHATSAPP_HOME_CHANNEL_THREAD_ID=

# Diagnostik bridge. Aktifkan hanya saat menelusuri pesan yang hilang; event
# debug membanjiri platforms/whatsapp/bridge.log. Perubahannya baru berlaku
# setelah proses bridge benar-benar dimatikan, bukan sekadar gateway restart.
# WHATSAPP_DEBUG=true

# --- Server API opsional ----------------------------------------------------
# Isi hanya bila API server Hermes akan dibuka di luar localhost. Kunci wajib.
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=
