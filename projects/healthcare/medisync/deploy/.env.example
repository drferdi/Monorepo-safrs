# Medisync — contoh variabel lingkungan
#
# Salin ke <HERMES_HOME>/profiles/avery/.env dan isi nilainya.
# Berkas .env yang sudah terisi JANGAN pernah di-commit.

# --- Penyedia model ---------------------------------------------------------
OPENROUTER_API_KEY=

# --- WhatsApp ---------------------------------------------------------------
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
# Daftar pengguna yang boleh berinteraksi, dipisah koma.
WHATSAPP_ALLOWED_USERS=
WHATSAPP_REPLY_PREFIX=
# ignore | pair — perilaku terhadap DM dari nomor tak dikenal.
WHATSAPP_DM_POLICY=ignore
# Kanal tujuan hasil cron dan pesan lintas platform.
WHATSAPP_HOME_CHANNEL=
WHATSAPP_HOME_CHANNEL_THREAD_ID=

# --- Server API opsional ----------------------------------------------------
# Isi hanya bila API server Hermes akan dibuka di luar localhost. Kunci wajib.
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=
