# Blueprinted & built by Drferdi.
# ── IntelligenceBoard — Environment Variables ────────────────────────────────
# Copy file ini ke .env.local dan isi nilainya
# JANGAN commit .env.local ke Git

# ─── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── LIVEKIT ──────────────────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── WHATSAPP CLOUD API ───────────────────────────────────────
WHATSAPP_CLOUD_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# MedBoard's own diagnosis engine is retired; MIRA (via Assist) provides the differential.
# Unset or false: /api/cdss/diagnose and /api/clinical/differential/evaluate answer 503,
# and /api/consult skips the engine. Set true only to bring the old engine back.
LEGACY_CDSS_ENGINE_ENABLED=false

# ePuskesmas EMR / RPA
EMR_BASE_URL=https://kotakediri.epuskesmas.id
EMR_LOGIN_URL=https://kotakediri.epuskesmas.id/login
EMR_USERNAME=
EMR_PASSWORD=
EMR_HEADLESS=true
EMR_SESSION_STORAGE_PATH=runtime/emr-session.json

# LB1 pipeline runtime
LB1_CONFIG_PATH=runtime/lb1-config.yaml
LB1_DATA_SOURCE_DIR=runtime/lb1-data
LB1_OUTPUT_DIR=runtime/lb1-output
LB1_HISTORY_FILE=runtime/lb1-run-history.jsonl
LB1_TEMPLATE_PATH=runtime/Laporan SP3 LB1.xlsx
LB1_MAPPING_PATH=runtime/diagnosis_mapping.csv

# Crew Access
CREW_ACCESS_SECRET=
CREW_ACCESS_USERS_JSON=
# Asisten Medis (sentra-assist) bridge automation token — must match token in extension bridge-client.ts
CREW_ACCESS_AUTOMATION_TOKEN=
# Pending registrations and crew profiles are JSON files. On Railway put both inside the one
# persistent volume (railway.toml mounts /app/runtime/bridge-queue) or a redeploy loses them:
#   CREW_ACCESS_REGISTRATION_REQUESTS_FILE=/app/runtime/bridge-queue/crew-access-registration-requests.json
#   CREW_ACCESS_PROFILE_FILE=/app/runtime/bridge-queue/crew-access-user-profiles.json
CREW_ACCESS_REGISTRATION_REQUESTS_FILE=
CREW_ACCESS_PROFILE_FILE=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
TRUST_PROXY_HEADERS=true
# CORS allowlist for cross-origin API access (comma-separated origins, no trailing slash)
CORS_ALLOWED_ORIGINS=
# Allowed Chrome extension IDs for bridge/API preflight, comma-separated
CORS_ALLOWED_EXTENSION_IDS=

# ─── MONAI AI Vision ─────────────────────────────────────────
MONAI_SERVICE_URL=http://localhost:8100
MONAI_API_TOKEN=changeme-shared-secret

# App
PORT=7000
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=https://medboard.sentrahai.com
SENTRY_DSN=
RESEND_API_KEY=
