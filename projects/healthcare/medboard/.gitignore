# MedBoard — .gitignore
# Sections: dependencies, build output, environment and secrets, local state,
# tests, editors and OS, internal working files, clinical data, model weights.

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.pnpm-store/

# ── Build output ─────────────────────────────────────────────
.next/
out/
dist/
build/
.output/
.turbo/
.cache/
*.tsbuildinfo
.eslintcache

# ── Environment and secrets (never commit) ───────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
secrets.json
secrets.yaml
credentials.json
service-account*.json
*-service-account.json

# ── Local runtime state and generated reports ───────────────
# The server writes queues, histories and contributions here.
/runtime/
/output/
mintlify-docs/
*.log
/logs/
npm-debug.log*
pnpm-debug.log*

# ── Tests and coverage ───────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/

# ── Editors and OS ───────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

