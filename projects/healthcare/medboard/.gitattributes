# Normalise line endings to LF in the repository.
* text=auto eol=lf

# Binary files: never convert or diff as text. PNG images are stored in Git LFS.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.xlsx binary
