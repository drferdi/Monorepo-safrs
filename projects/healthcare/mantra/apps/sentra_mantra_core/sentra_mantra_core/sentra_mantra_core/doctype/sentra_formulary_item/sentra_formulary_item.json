  {"fieldname": "active_ingredient", "fieldtype": "Data", "label": "Zat Aktif", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1, "description": "Nama zat aktif, bukan merek. Dua item dengan zat aktif dan kekuatan sama saling menggantikan."},
  {"fieldname": "strength", "fieldtype": "Data", "label": "Kekuatan", "in_list_view": 1, "search_index": 1, "description": "Contoh: 500mg. Substitusi hanya dianggap setara bila kekuatannya sama."},
  {"fieldname": "dosage_form", "fieldtype": "Data", "label": "Bentuk Sediaan"}
 ],
