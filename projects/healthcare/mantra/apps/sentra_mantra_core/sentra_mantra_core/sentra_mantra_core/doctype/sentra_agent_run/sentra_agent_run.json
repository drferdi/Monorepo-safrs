{
 "doctype": "DocType",
 "name": "Sentra Agent Run",
 "module": "Sentra MANTRA Core",
 "autoname": "format:RUN-{YYYY}-{MM}-{#####}",
 "engine": "InnoDB",
 "custom": 0,
 "field_order": [
  "agent", "run_date", "trigger", "status",
  "sec_waktu", "started_at", "finished_at",
  "sec_hasil", "rules_executed", "rules_failed", "cards_published", "cards_queued", "cards_skipped", "narration_ok",
  "sec_jejak", "failures_json", "violations_json", "displaced_json"
 ],
 "fields": [
  {"fieldname": "agent", "fieldtype": "Link", "label": "Agen", "options": "Sentra Agent Definition", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "run_date", "fieldtype": "Date", "label": "Tanggal Eksekusi", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "trigger", "fieldtype": "Select", "label": "Pemicu Eksekusi", "options": "Terjadwal\nManual", "default": "Terjadwal"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Berjalan\nSelesai\nGagal", "default": "Berjalan", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "sec_waktu", "fieldtype": "Section Break", "label": "Waktu"},
  {"fieldname": "started_at", "fieldtype": "Datetime", "label": "Mulai", "reqd": 1},
  {"fieldname": "finished_at", "fieldtype": "Datetime", "label": "Selesai"},
  {"fieldname": "sec_hasil", "fieldtype": "Section Break", "label": "Hasil"},
  {"fieldname": "rules_executed", "fieldtype": "Int", "label": "Aturan Dijalankan", "default": "0", "in_list_view": 1},
  {"fieldname": "rules_failed", "fieldtype": "Int", "label": "Aturan Gagal", "default": "0", "in_list_view": 1},
  {"fieldname": "cards_published", "fieldtype": "Int", "label": "Kartu Terbit", "default": "0", "in_list_view": 1},
  {"fieldname": "cards_queued", "fieldtype": "Int", "label": "Kartu ke Antrean Ringkasan", "default": "0"},
  {"fieldname": "cards_skipped", "fieldtype": "Int", "label": "Kartu Dilewati (dedup)", "default": "0"},
  {"fieldname": "narration_ok", "fieldtype": "Check", "label": "Lapis Narasi Berhasil", "default": "1"},
  {"fieldname": "sec_jejak", "fieldtype": "Section Break", "label": "Jejak Kegagalan"},
  {"fieldname": "failures_json", "fieldtype": "Code", "label": "Kegagalan (JSON)", "options": "JSON"},
  {"fieldname": "violations_json", "fieldtype": "Code", "label": "Pelanggaran Izin (JSON)", "options": "JSON"},
  {"fieldname": "displaced_json", "fieldtype": "Code", "label": "Tingkat yang Tergeser Antrean (JSON)", "options": "JSON", "description": "Temuan yang kalah rebutan slot harian, dengan tingkat aslinya. Kosong berarti tidak ada yang tergeser."}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1, "print": 1, "email": 1, "share": 1}
 ],
 "sort_field": "creation",
 "sort_order": "DESC"
}
