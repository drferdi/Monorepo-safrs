  {"fieldname": "threshold_secondary", "fieldtype": "Float", "label": "Ambang Kedua", "precision": "2", "description": "Sebagian kondisi ditentukan dua angka, mis. 90 hari DAN nilai di atas Rp 5.000.000. Kosongkan bila aturan hanya butuh satu ambang."},
  {"fieldname": "threshold_secondary_unit", "fieldtype": "Select", "label": "Satuan Ambang Kedua", "options": "\nIDR\nPersen\nHari\nJumlah"},
  {"fieldname": "severity", "fieldtype": "Select", "label": "Tingkat Kartu", "options": "Mendesak\nPerlu Tinjauan\nPerlu Keputusan\nInformasi", "default": "Perlu Tinjauan", "reqd": 1, "in_list_view": 1},
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Aktif", "default": "1", "in_list_view": 1}
