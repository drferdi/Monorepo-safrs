{
  "schemaVersion": 1,
  "id": "healthcare/sentrapedia-website",
  "owner": "Gaffer",
  "risk": "R2",
  "runtime": { "name": "node", "version": "24" },
  "packageManager": { "name": "none", "version": null, "lockfile": null },
  "commands": {
    "install": { "program": "node", "args": ["tools/install-check.mjs"] },
    "lint": { "program": "node", "args": ["tools/lint.mjs"] },
    "typecheck": { "program": null, "args": [], "notApplicableReason": "Runtime and tests are JavaScript, HTML, and CSS; no TypeScript is included." },
    "test": { "program": "node", "args": ["--run", "test"] },
    "build": { "program": "node", "args": ["--run", "build"] },
    "run": { "program": "node", "args": ["--run", "start"] },
    "deployDryRun": { "program": "node", "args": ["--run", "deploy:dry-run"] }
  },
  "smoke": { "kind": "http", "host": "127.0.0.1", "port": 3401, "path": "/", "expectedStatus": 200, "startupTimeoutSeconds": 30 },
  "artifacts": ["site/index.html"],
  "externalDependencies": [
    { "kind": "service", "name": "Optional contact delivery through Resend", "locator": "RESEND_API_KEY, RESEND_FROM_EMAIL, and CONTACT_PUBLIC_ORIGIN for HTTPS", "required": false }
  ],
  "mutableStatePaths": ["site", "reference/verification.json"]
}
