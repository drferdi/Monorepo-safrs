# Blueprinted & built by drfediiskandar.
# Sentra Assist Environment Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# =============================================================================
# SENTRA BACKEND API
# =============================================================================

# API Base URL (HTTPS required in production)
VITE_SENTRA_API_URL=https://api.sentra.local

# API Authentication Key (get from Sentra admin)
VITE_SENTRA_API_KEY=sk_dev_your_api_key_here

# Facility identifier for multi-tenant setup
VITE_FACILITY_ID=PUSKESMAS_BALOWERTI

# =============================================================================
# DEVELOPMENT OPTIONS
# =============================================================================

# Enable mock responses for development (true/false)
# Set to "true" to use local mock data instead of real API
VITE_USE_MOCK=true

# API request timeout in milliseconds (default: 10000)
VITE_API_TIMEOUT=10000

# Enable debug logging (true/false)
VITE_DEBUG=false

# Enable focused debug logging for visit history scraper/bridge
VITE_DEBUG_RIWAYAT=false

# Enable scoped debug channels (fallback to VITE_DEBUG when omitted)
VITE_DEBUG_BACKGROUND=false
VITE_DEBUG_CONTENT=false
VITE_DEBUG_FILLER=false

# Message timeout tuning (ms) with runtime clamping [1000..60000]
VITE_MESSAGE_TIMEOUT_DEFAULT=10000
VITE_MESSAGE_TIMEOUT_FILL=8000
VITE_MESSAGE_TIMEOUT_SCRAPE=5000
VITE_MESSAGE_TIMEOUT_VISIT_FETCH=15000
VITE_MESSAGE_TIMEOUT_AI=30000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable AI diagnosis suggestions
VITE_FEATURE_DIAGNOSIS_AI=true

# Enable AI prescription recommendations
VITE_FEATURE_PRESCRIPTION_AI=true

# Enable real-time DDI checking
VITE_FEATURE_DDI_CHECK=true

# Enable pediatric dosing calculator
VITE_FEATURE_PEDIATRIC_DOSE=true

# =============================================================================
# IDE-V1 DIAGNOSIS ENGINE — OPENAI LLM
# =============================================================================

# OpenAI API key TIDAK LAGI diisi di sini. Sejak 2026-07-05, kunci diisi
# langsung di dalam ekstensi lewat Settings UI (tersimpan di
# browser.storage.local per-instalasi, tidak ikut ke build/commit apa pun).
# Tanpa kunci terisi di Settings, sistem otomatis fallback ke KB-only
# (tidak error, tidak crash).

# OpenAI model (default: gpt-4o-mini — alternatif: gpt-4o, gpt-4-turbo)
SENTRA_OPENAI_MODEL=gpt-4o-mini

# OpenAI request timeout in milliseconds (default: 30000)
SENTRA_OPENAI_TIMEOUT_MS=30000

# Disable trajectory bridge safety layer (default: enabled)
# SENTRA_DISABLE_TRAJECTORY_BRIDGE=true

# Disable pharmacotherapy recommendations (default: enabled)
# SENTRA_DISABLE_THERAPY=true

# Enable Diagnosis V2 shadow mode without replacing production V1
SENTRA_DIAGNOSIS_V2_SHADOW=false

# =============================================================================
# DIAGNOSIS ENGINE SELECTION (lib/diagnosis-engine)
# =============================================================================

# Which diagnosis engine runs: legacy (default) or mira. With mira, physicians still see
# the legacy result; MIRA runs alongside and only its outcome is audited (see ADR-005).
# SENTRA_DIAGNOSIS_ENGINE=legacy

# Base URL of the Sentra-side reasoning service that runs MIRA. The extension never holds
# an OpenAI key for MIRA. Unset = MIRA engine unavailable (no request is sent).
# VITE_MIRA_SERVICE_URL=
