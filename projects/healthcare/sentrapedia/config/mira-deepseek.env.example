# Separate Sentrapedia MIRA instance; paid Flash approved by Chief.
MIRA_SERVICE_ENV=development
# Gemini API directly: the engine's openai provider pointed at Google's OpenAI-compatible endpoint.
MIRA_LLM_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MIRA_DATA_POLICY=synthetic-only
MIRA_PLAN_MODEL=gemini-3.1-flash-lite
MIRA_PLAN_MODEL_CHOICES=gemini-3.1-flash-lite
MIRA_ASSESS_MODEL=gemini-3.1-flash-lite
MIRA_PROVISIONAL_DIFFERENTIAL=true
MIRA_FAST_ASSESSMENT=true
MIRA_FAST_THERAPY=true
MIRA_STEP_DEADLINE_S=20
MIRA_MAX_USD_PER_STEP=0.10
MIRA_DAILY_BUDGET_USD=5
PYTHON_DOTENV_DISABLED=1
# The Gemini API key (paid tier).
OPENAI_API_KEY=
MIRA_DEV_TOKEN=
