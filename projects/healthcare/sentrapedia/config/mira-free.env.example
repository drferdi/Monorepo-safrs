# Settings for a SEPARATE existing MIRA instance, not the shared Med Assist service.
MIRA_SERVICE_ENV=development
MIRA_LLM_PROVIDER=openrouter
MIRA_DATA_POLICY=synthetic-only
MIRA_PLAN_MODEL=apodex/apodex-1.1-mini:free
MIRA_PLAN_MODEL_CHOICES=apodex/apodex-1.1-mini:free
MIRA_ASSESS_MODEL=apodex/apodex-1.1-mini:free
MIRA_STEP_DEADLINE_S=60
# Keep the existing fixed ZDR/data-collection-deny/require-parameters policy.
# Prevent loading another project's .env.
PYTHON_DOTENV_DISABLED=1
# Set these securely in the service process, never commit values.
OPENROUTER_API_KEY=
MIRA_DEV_TOKEN=
