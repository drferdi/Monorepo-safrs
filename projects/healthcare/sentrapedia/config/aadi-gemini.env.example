# Reference only: no script reads this file. `npm run dev` passes these values to the engine itself
# (engineEnvironment in scripts/aadi-runtime.mjs) and maps GEMINI_API_KEY to OPENAI_API_KEY.
# Separate Sentrapedia AADI instance; paid Flash approved by Chief.
AADI_SERVICE_ENV=development
# Gemini API directly: the engine's openai provider pointed at Google's OpenAI-compatible endpoint.
AADI_LLM_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AADI_DATA_POLICY=synthetic-only
AADI_PLAN_MODEL=gemini-3.1-flash-lite
AADI_PLAN_MODEL_CHOICES=gemini-3.1-flash-lite
AADI_ASSESS_MODEL=gemini-3.1-flash-lite
AADI_PROVISIONAL_DIFFERENTIAL=true
AADI_FAST_ASSESSMENT=true
AADI_FAST_THERAPY=true
# Copies of each raced fast-assessment part: the first valid answer wins, the rest are cancelled but still charged.
# The capsule launcher sets this from fastCopies in scripts/aadi-profile.json (1 since 2026-10-17).
AADI_FAST_COPIES=1
AADI_STEP_DEADLINE_S=20
AADI_MAX_USD_PER_STEP=0.10
AADI_DAILY_BUDGET_USD=5
PYTHON_DOTENV_DISABLED=1
# The Gemini API key (paid tier).
OPENAI_API_KEY=
AADI_DEV_TOKEN=
