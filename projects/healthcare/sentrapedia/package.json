{
  "name": "sentrapedia",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "postinstall": "node scripts/install-mira.mjs && node scripts/install-theoracle-model.mjs && npm --prefix apps/site run install:check",
    "dev": "node scripts/run-system.mjs dev",
    "build": "node scripts/build-system.mjs && npm --prefix apps/site run build",
    "start": "node scripts/run-system.mjs start",
    "system:check": "node scripts/run-system.mjs check",
    "lint": "eslint src tests && npm --prefix apps/site run lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm --prefix apps/site test",
    "test:system": "node --test tests/system-runtime.node-test.mjs",
    "test:mira": "node scripts/test-mira.mjs",
    "test:all": "npm test && npm run test:system && npm run test:mira",
    "deploy:dry-run": "node scripts/deploy-dry-run.mjs && npm --prefix apps/site run deploy:dry-run",
    "site:docs": "npm --prefix apps/site run docs:verify",
    "site:start": "npm --prefix apps/site run start",
    "site:verify": "npm --prefix apps/site run verify",
    "benchmark:oracle": "node scripts/benchmark-theoracle-grounding.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  }
}
