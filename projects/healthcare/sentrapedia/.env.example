# Unified launcher starts the bundled MIRA engine and generates its private URL/token.
# Both stages preserve the approved Gemini Flash profile. Server-side provider key only.
OPENROUTER_API_KEY=

# Dify Cloud / Self-hosted Integration
DIFY_API_KEY=
DIFY_API_URL=https://api.dify.ai/v1

# Targeted therapy runs by default; set false to use the legacy single-step path.
# MIRA_TARGETED_THERAPY=false
