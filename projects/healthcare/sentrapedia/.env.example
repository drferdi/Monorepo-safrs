# Optional existing local MIRA service. Keep the token server-side only.
MIRA_SERVICE_URL=http://127.0.0.1:8787
MIRA_SERVICE_TOKEN=

# Both MIRA stages use the approved paid Flash profile; see config/mira-deepseek.env.example.
# Optional key for the separate MIRA service launcher; never exposed to browser.
OPENROUTER_API_KEY=
