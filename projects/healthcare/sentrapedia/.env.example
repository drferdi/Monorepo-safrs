# Unified launcher starts the bundled MIRA engine and generates its private URL/token.
# MIRA calls the Gemini API directly (gemini-3.1-flash-lite, scripts/mira-profile.json). Server-side key only;
# use a paid-tier key: Google may use free-tier prompts to improve its products.
GEMINI_API_KEY=

# Targeted therapy runs by default; set false to use the legacy single-step path.
# MIRA_TARGETED_THERAPY=false
