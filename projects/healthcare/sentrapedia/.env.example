# Unified launcher starts the bundled AADI engine and generates its private URL/token.
# AADI calls the Gemini API directly (gemini-3.1-flash-lite, scripts/aadi-profile.json). Server-side key only;
# use a paid-tier key: Google may use free-tier prompts to improve its products.
GEMINI_API_KEY=

# Do not set AADI_SERVICE_URL or AADI_SERVICE_TOKEN here: `npm run dev` generates both on every start, and
# stale values make `npx next dev` call an engine that is not running (HTTP 502).
# Optional local listener: PORT (default 3101) and SENTRAPEDIA_HOST (default 127.0.0.1).

# Clerk owns closed-beta invitations, verification and sessions. Use separate dev/prod instances.
# Set both keys securely; never commit a filled environment file. Only the publishable key is public.
SENTRAPEDIA_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production requires matching live keys plus the exact HTTPS origin below. Missing config denies access.
# Local-only development without Clerk: SENTRAPEDIA_AUTH_MODE=local with NODE_ENV=development,
# SENTRAPEDIA_HOST=127.0.0.1 and no SENTRAPEDIA_PUBLIC_ORIGIN. Never use with a tunnel/public listener.

# Targeted therapy runs by default; set false to use the legacy single-step path.
# AADI_TARGETED_THERAPY=false

# Closed beta only (behind Cloudflare Tunnel and Access; never expose the port directly).
# SENTRAPEDIA_PUBLIC_ORIGIN=https://beta.sentrapedia.com
# Analyses that may run at the same time, 1-8 (default 1). Each still reserves its step cap from the daily budget.
# AADI_MAX_CONCURRENT=3

# Server-side workspace sync (optional; absent or SENTRAPEDIA_SYNC_MODE=off keeps the browser authoritative).
# Connect as the non-owner runtime role, never Neon's owner role: that role carries BYPASSRLS and would skip
# every row-level security policy. DATABASE_URL_UNPOOLED is for migrations only, never for request traffic.
# SENTRAPEDIA_DATABASE_URL=
# SENTRAPEDIA_SYNC_MODE=off
