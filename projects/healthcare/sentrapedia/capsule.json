{
  "id": "sentrapedia",
  "runtime": { "name": "node", "version": ">=24" },
  "risk": "R2",
  "lifecycle": {
    "install": ["npm", "ci", "--workspaces=false"],
    "build": ["npm", "run", "build"],
    "test": ["npm", "run", "test:all"],
    "run": ["npm", "run", "dev"],
    "lint": ["npm", "run", "lint"],
    "typecheck": ["npm", "run", "typecheck"],
    "deployDryRun": ["npm", "run", "deploy:dry-run"]
  },
  "requiredEnvironment": ["OPENROUTER_API_KEY"],
  "externalServices": ["OpenRouter provider API; synthetic cases only; Gemini 2.5 Flash for both stages"],
  "buildOutputs": [".next/standalone", ".next/static"],
  "generatedPaths": [".next", "node_modules", "next-env.d.ts"],
  "sensitiveSurfaces": ["Browser-local patient and encounter data; fictional data only", "Optional microphone speech recognition may contact browser speech provider"],
  "rootDependencies": []
}
