{
  "schemaVersion": 1,
  "id": "healthcare/sentrapedia",
  "owner": "Gaffer",
  "risk": "R2",
  "runtime": {
    "name": "node",
    "version": "24"
  },
  "packageManager": {
    "name": "npm",
    "version": "11.19.0",
    "lockfile": "package-lock.json"
  },
  "commands": {
    "install": { "program": "node", "args": ["scripts/npm.mjs", "ci", "--workspaces=false"], "timeoutSeconds": 600 },
    "lint": { "program": "node", "args": ["scripts/npm.mjs", "run", "lint"], "timeoutSeconds": 600 },
    "typecheck": { "program": "node", "args": ["scripts/npm.mjs", "run", "typecheck"], "timeoutSeconds": 600 },
    "test": {
      "program": "node",
      "args": ["scripts/npm.mjs", "run", "test:all"],
      "timeoutSeconds": 600
    },
    "build": { "program": "node", "args": ["scripts/npm.mjs", "run", "build"], "timeoutSeconds": 600 },
    "run": { "program": "node", "args": ["scripts/npm.mjs", "run", "start"] },
    "deployDryRun": { "program": "node", "args": ["scripts/npm.mjs", "run", "deploy:dry-run"], "timeoutSeconds": 600 }
  },
  "smoke": {
    "kind": "http",
    "host": "127.0.0.1",
    "port": 3101,
    "path": "/",
    "expectedStatus": 200,
    "startupTimeoutSeconds": 120
  },
  "artifacts": [".next/BUILD_ID"],
  "externalDependencies": [
    { "kind": "registry", "name": "npm registry", "locator": "https://registry.npmjs.org", "required": true },
    { "kind": "registry", "name": "Python package registry", "locator": "https://pypi.org", "required": true },
    { "kind": "service", "name": "OpenRouter model provider; synthetic cases only", "locator": "OPENROUTER_API_KEY", "required": true }
  ],
  "mutableStatePaths": ["node_modules", ".next", ".runtime", "tsconfig.tsbuildinfo", ".env.local"]
}
