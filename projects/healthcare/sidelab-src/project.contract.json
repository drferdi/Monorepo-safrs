{
  "schemaVersion": 1,
  "id": "healthcare/sidelab-src",
  "owner": "Chief (dr. Ferdi Iskandar)",
  "risk": "R2",
  "runtime": {
    "name": "node",
    "version": "24"
  },
  "packageManager": {
    "name": "pnpm",
    "version": "11.21.0",
    "lockfile": "pnpm-lock.yaml"
  },
  "commands": {
    "install": { "program": "node", "args": ["scripts/install.mjs"], "timeoutSeconds": 600 },
    "lint": {
      "program": null,
      "args": [],
      "notApplicableReason": "The workspace has no linter configuration; TypeScript project references are checked by `typecheck`."
    },
    "typecheck": { "program": "node", "args": ["scripts/pnpm.mjs", "run", "typecheck"], "timeoutSeconds": 600 },
    "test": { "program": "node", "args": ["scripts/pnpm.mjs", "run", "test"], "timeoutSeconds": 600 },
    "build": { "program": "node", "args": ["scripts/with-local-env.mjs", "run", "build"], "timeoutSeconds": 600 },
    "run": { "program": "node", "args": ["scripts/with-local-env.mjs", "run", "start:local"] },
    "deployDryRun": { "program": "node", "args": ["scripts/pnpm.mjs", "run", "deploy:dry-run"] }
  },
  "smoke": {
    "kind": "http",
    "host": "127.0.0.1",
    "port": 4345,
    "path": "/",
    "expectedStatus": 200,
    "startupTimeoutSeconds": 120
  },
  "artifacts": ["artifacts/stride-dashboard/dist/public/index.html"],
  "externalDependencies": [
    { "kind": "registry", "name": "npm registry", "locator": "https://registry.npmjs.org", "required": true },
    { "kind": "registry", "name": "Python Package Index for sidelab-engine", "locator": "https://pypi.org/simple", "required": true },
    { "kind": "runtime", "name": "Python 3.12 or newer for sidelab-engine", "locator": "python", "required": true },
    { "kind": "database", "name": "PostgreSQL for the API server (Drizzle)", "locator": "DATABASE_URL", "required": false },
    { "kind": "service", "name": "DeepSeek model provider for the engine", "locator": "DEEPSEEK_API_KEY", "required": false },
    { "kind": "service", "name": "Local Ollama model server for the engine", "locator": "http://127.0.0.1:11434", "required": false }
  ],
  "mutableStatePaths": [
    "node_modules",
    "artifacts/api-server/node_modules",
    "artifacts/api-server/dist",
    "artifacts/mockup-sandbox/node_modules",
    "artifacts/mockup-sandbox/dist",
    "artifacts/sidelab-video/node_modules",
    "artifacts/sidelab-video/dist",
    "artifacts/stride-dashboard/node_modules",
    "artifacts/stride-dashboard/dist",
    "lib/api-client-react/node_modules",
    "lib/api-client-react/dist",
    "lib/api-spec/node_modules",
    "lib/api-zod/node_modules",
    "lib/api-zod/dist",
    "lib/db/node_modules",
    "lib/db/dist",
    "sidelab-engine/.venv",
    "sidelab-engine/.cache",
    "sidelab-engine/.coverage",
    "sidelab-engine/sessions",
    "electron-app/node_modules",
    "artifacts/api-server/.tsbuildinfo",
    "artifacts/mockup-sandbox/.tsbuildinfo",
    "lib/api-client-react/tsconfig.tsbuildinfo",
    "lib/api-zod/tsconfig.tsbuildinfo",
    "lib/db/tsconfig.tsbuildinfo"
  ]
}
