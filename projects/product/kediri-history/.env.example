# Kediri — A Living Civilization
# Nama variabel saja. JANGAN pernah menaruh nilai nyata di berkas ini.
# Salin ke .env.local (tidak dilacak git) untuk pengembangan lokal.

NODE_ENV=
NEXT_PUBLIC_SITE_URL=

# Payload CMS + PostgreSQL. Instans lokal: infra/docker-compose.yml (port 54330).
DATABASE_URL=
PAYLOAD_SECRET=
PREVIEW_SECRET=

# Object storage S3-compatible. Instans lokal: MinIO di infra/docker-compose.yml (9010).
# Publik hanya memuat derivatif yang sudah bersih hak; privat memuat master
# arsip dan dokumen hak dan tidak pernah dilayani ke browser.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BASE_URL=
