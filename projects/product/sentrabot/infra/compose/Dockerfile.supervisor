FROM node:24.18-alpine
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json ./
COPY packages ./packages
COPY projects/sentrabot ./projects/sentrabot
RUN corepack enable && pnpm install --frozen-lockfile --prod=false && pnpm --filter @sentra/sentrabot-sandbox-supervisor build
CMD ["pnpm", "--filter", "@sentra/sentrabot-sandbox-supervisor", "start"]
