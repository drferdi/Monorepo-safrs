FROM node:24.18-alpine
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json ./
COPY packages ./packages
COPY projects/sentrabot ./projects/sentrabot
ARG BUILD_APP_URL=https://sentrabot.invalid
ARG BUILD_DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
ARG BUILD_BETTER_AUTH_URL=https://sentrabot.invalid
ARG BUILD_BETTER_AUTH_SECRET=build-only-synthetic-secret-not-for-runtime
RUN corepack enable && pnpm install --frozen-lockfile --prod=false && APP_URL="$BUILD_APP_URL" DATABASE_URL="$BUILD_DATABASE_URL" BETTER_AUTH_URL="$BUILD_BETTER_AUTH_URL" BETTER_AUTH_SECRET="$BUILD_BETTER_AUTH_SECRET" pnpm --filter @sentra/sentrabot-web build
CMD ["pnpm", "--filter", "@sentra/sentrabot-web", "start"]
