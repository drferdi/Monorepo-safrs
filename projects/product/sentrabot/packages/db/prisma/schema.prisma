  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([computerId, botId])
  @@index([runId])
  @@index([computerId, expiresAt])
  @@map("computer_execution_leases")
}

