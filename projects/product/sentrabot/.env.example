NODE_ENV=development
DATABASE_URL=postgres://sentrabot:sentrabot@127.0.0.1:5433/sentrabot
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:3100
# Listener address. Keep loopback unless a container or trusted reverse proxy must reach the API.
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=
ENCRYPTION_KEY=replace-with-64-random-hex-characters
DATA_DIR=./data
SANDBOX_SUPERVISOR_URL=http://127.0.0.1:7091
# Dedicated credentials (distinct from BETTER_AUTH_SECRET). Required for Docker sandboxes /
# screen proxy outside local development.
SANDBOX_SUPERVISOR_TOKEN=replace-with-32-plus-character-supervisor-token
SCREEN_PROXY_SECRET=replace-with-32-plus-character-screen-proxy-secret
# docker | e2b | daytona | box | none. "desktop" runs commands on this host without isolation
# (experimental trusted host execution; see docs/architecture.md).
SANDBOX_PROVIDER=docker
# Experimental hybrid control-plane relay stream (/v1/relay/*). Off by default;
# no client consumes it yet. Set to "enabled" to mount it.
SENTRABOT_CONTROL_PLANE_RELAY=
# Optional Docker daemon socket. Defaults to /var/run/docker.sock (Unix) or
# //./pipe/docker_engine (Windows). Set for rootless Docker, Colima, or custom paths.
# DOCKER_HOST takes precedence over DOCKER_SOCKET when both are set.
# DOCKER_SOCKET=
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=
BOX_API_KEY=
# Optional Box API base URL; defaults to https://ascii.dev/api/box/v1.
BOX_API_URL=
AGENT_RUNTIME=pi
WAKEUP_DRIVER=graphile
# Pause or stop computers after this many idle ms. Minimum 30000.
SANDBOX_IDLE_MS=600000
SANDBOX_COMMAND_TIMEOUT_MS=300000
# Optional per-turn tool-call fuse for the Pi agent runtime. Unset, empty, or 0
# means unlimited (default). Set a positive integer to soft-stop a turn that
# exceeds the budget and still emit a final assistant message.
MAX_TOOL_CALLS_PER_TURN=
# Deployment-wide fallback model. PI_DEFAULT_PROVIDER picks which key below is used.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
PI_DEFAULT_PROVIDER=openrouter
# Text-only by default. Computer use (screenshots via computer_observe / computer_act)
# needs a vision-capable model — one whose catalog entry lists image input modalities
# (e.g. openai/gpt-4o). Tests use COMPUTER_E2E_MODEL for that.
PI_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
# Optional local OpenAI-compatible models. Leave blank to disable the provider.
SENTRABOT_LOCAL_MODELS=
SENTRABOT_LOCAL_MODELS_URL=http://127.0.0.1:11434/v1
SENTRABOT_LOCAL_CONTEXT_WINDOW=32768
SENTRABOT_LOCAL_MAX_TOKENS=4096
# Allow user-connected OpenAI-compatible endpoints on public hostnames (default: private/loopback only).
SENTRABOT_OPENAI_COMPAT_ALLOW_PUBLIC=
E2B_API_KEY=
COMPOSIO_API_KEY=
# Optional alternative managed connector provider.
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_PROJECT_ID=
PIPEDREAM_ENVIRONMENT=development
# Optional SendBlue adapter for the phone messaging surface (all four required to enable).
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
SENDBLUE_SIGNING_SECRET=
SENDBLUE_PHONE_NUMBER=

# Optional WhatsApp Business Cloud API channel (all five required to enable).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_PHONE_E164=
# Optional. Meta only accepts pre-approved templates more than 24h after the
# user's last message, so without this a routine that finishes overnight can
# never reach them on WhatsApp (it still lands in the web thread). Approve a
# utility template with exactly one body parameter, e.g.
# "Sentra selesai mengerjakan: {{1}}. Balas pesan ini untuk melanjutkan."
# Sends outside the window are billed per message.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=id

# Language of the deployment's own phone-channel copy (id | en). Defaults to id.
# Agent replies are unaffected — they follow whatever language the user writes.
PHONE_LOCALE=id
# Speech-to-text for inbound WhatsApp voice notes. Numbers that text in are
# provisioned as synthetic users with no voice credential of their own, so this
# deployment key is what makes voice notes work; without it a voice note gets an
# honest "not supported yet" reply instead of being dropped. (elevenlabs | openai)
PHONE_TRANSCRIBE_PROVIDER=
PHONE_TRANSCRIBE_API_KEY=

SUPERMEMORY_API_KEY=
# Optional. Defaults to https://api.supermemory.ai. Self-hosted: http://localhost:6767
SUPERMEMORY_API_URL=
SMTP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
# Optional. GET /health returns this as `revision` so you can confirm the deployed commit.
GIT_SHA=

# --- Compose production deployments ---
# Absolute path of this checkout as the Docker *daemon* sees it. Production Compose defaults to
# /srv/sentrabot on Linux; override it for any other host path so the updater bind mount resolves.
# Linux override: SENTRABOT_DEPLOY_DIR=/opt/sentrabot
# Docker Desktop on Windows (C:\Users\you\sentrabot):
#   SENTRABOT_DEPLOY_DIR=/run/desktop/mnt/host/c/Users/you/sentrabot
SENTRABOT_DEPLOY_DIR=
# Published images (defaults match this repository). Tag `local` is built from the checkout.
SENTRABOT_IMAGE=ghcr.io/drferdii/sentrabot/app
SENTRABOT_IMAGE_TAG=local
SENTRABOT_IMAGE_TAG_PREVIOUS=
SENTRABOT_UPDATER_IMAGE=ghcr.io/drferdii/sentrabot/updater
SENTRABOT_UPDATER_IMAGE_TAG=local
# Required only when starting the opt-in `updater` Compose profile; the sidecar refuses to start
# without it. Use a dedicated random value, not BETTER_AUTH_SECRET,
# SANDBOX_SUPERVISOR_TOKEN, or SCREEN_PROXY_SECRET;
# ≥32 chars in production. Leave empty when the sidecar is disabled.
SENTRABOT_UPDATER_URL=
SENTRABOT_UPDATER_TOKEN=

# Optional default UI locale for the web SPA (en | de | ko). Overridden by
# localStorage key sentrabot.uiLocale when the user picks a language in Settings.
# VITE_DEFAULT_UI_LOCALE=en
