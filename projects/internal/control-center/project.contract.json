{
  "schemaVersion": 1,
  "id": "internal/control-center",
  "owner": "Gaffer",
  "risk": "R2",
  "runtime": { "name": "node", "version": "24.18.0" },
  "packageManager": {
    "name": "pnpm",
    "version": "11.21.0",
    "lockfile": "pnpm-lock.yaml"
  },
  "commands": {
    "install": {
      "program": "node",
      "args": ["scripts/pnpm.mjs", "install", "--frozen-lockfile"]
    },
    "lint": { "program": "node", "args": ["scripts/pnpm.mjs", "run", "lint"] },
    "typecheck": {
      "program": "node",
      "args": ["scripts/pnpm.mjs", "run", "typecheck"]
    },
    "test": { "program": "node", "args": ["scripts/pnpm.mjs", "run", "test"] },
    "build": {
      "program": "node",
      "args": ["scripts/pnpm.mjs", "run", "build"]
    },
    "run": {
      "program": "node",
      "args": [
        "scripts/pnpm.mjs",
        "--filter",
        "@sentra/control-center",
        "exec",
        "next",
        "start",
        "-H",
        "127.0.0.1",
        "-p",
        "3333"
      ]
    },
    "deployDryRun": {
      "program": "node",
      "args": ["scripts/deploy-dry-run.mjs"]
    }
  },
  "smoke": {
    "kind": "http",
    "host": "127.0.0.1",
    "port": 3333,
    "path": "/",
    "expectedStatus": 200,
    "startupTimeoutSeconds": 60
  },
  "artifacts": ["apps/web/.next"],
  "externalDependencies": [
    {
      "kind": "registry",
      "name": "npm registry",
      "locator": "https://registry.npmjs.org",
      "required": true
    },
    {
      "kind": "repository",
      "name": "SAFRS monorepo checkout it reports on (read-only)",
      "locator": "SENTRA_REPO_ROOT",
      "required": false
    }
  ],
  "mutableStatePaths": [
    "node_modules",
    "apps/web/node_modules",
    "apps/web/.next",
    "apps/web/next-env.d.ts",
    "apps/web/tsconfig.tsbuildinfo",
    "packages/token/node_modules"
  ]
}
