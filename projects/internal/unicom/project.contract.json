{
  "schemaVersion": 1,
  "id": "internal/unicom",
  "owner": "Chief",
  "risk": "R1",
  "runtime": {
    "name": "node",
    "version": "24.18.0"
  },
  "packageManager": {
    "name": "pnpm",
    "version": "11.21.0",
    "lockfile": "pnpm-lock.yaml"
  },
  "commands": {
    "install": { "program": "pnpm", "args": ["install", "--frozen-lockfile"] },
    "lint": { "program": "pnpm", "args": ["run", "lint"] },
    "typecheck": { "program": "pnpm", "args": ["run", "typecheck"] },
    "test": { "program": "pnpm", "args": ["run", "test"] },
    "build": { "program": "pnpm", "args": ["run", "build"] },
    "run": { "program": "pnpm", "args": ["run", "start", "--hostname", "127.0.0.1", "--port", "4330"] },
    "deployDryRun": { "program": "pnpm", "args": ["run", "deploy:dry-run"] }
  },
  "smoke": {
    "kind": "http",
    "host": "127.0.0.1",
    "port": 4330,
    "path": "/",
    "expectedStatus": 200,
    "startupTimeoutSeconds": 60
  },
  "artifacts": [".next/BUILD_ID"],
  "externalDependencies": [
    { "kind": "registry", "name": "npm registry", "locator": "https://registry.npmjs.org", "required": true },
    {
      "kind": "service",
      "name": "Vercel AI Gateway (model anthropic/claude-sonnet-4.6, selected by the operator)",
      "locator": "https://ai-gateway.vercel.sh/v3/ai",
      "required": false
    }
  ],
  "mutableStatePaths": []
}
