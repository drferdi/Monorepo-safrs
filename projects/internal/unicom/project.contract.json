{
  "schemaVersion": 1,
  "id": "internal/unicom",
  "owner": "Chief",
  "risk": "R1",
  "runtime": {
    "name": "node",
    "version": "24.18.0"
  },
  "packageManager": {
    "name": "pnpm",
    "version": "11.21.0",
    "lockfile": "pnpm-lock.yaml"
  },
  "commands": {
    "install": { "program": "pnpm", "args": ["install", "--frozen-lockfile"] },
    "lint": { "program": "pnpm", "args": ["run", "lint"] },
    "typecheck": { "program": "pnpm", "args": ["run", "typecheck"] },
    "test": { "program": "pnpm", "args": ["run", "test"] },
    "build": { "program": "pnpm", "args": ["run", "build"] },
    "run": { "program": "pnpm", "args": ["run", "start"] },
    "deployDryRun": { "program": "pnpm", "args": ["run", "deploy:dry-run"] }
  },
  "smoke": {
    "kind": "http",
    "command": { "program": "pnpm", "args": ["run", "smoke:production"] },
    "path": "/"
  },
  "artifacts": [".next/BUILD_ID"],
  "externalDependencies": ["npm registry", "optional AI model provider selected by the operator"],
  "mutableStatePaths": []
}
