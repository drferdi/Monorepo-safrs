{
  "name": "@safrs/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/next-production-build.mjs",
    "dev": "next dev -H 127.0.0.1",
    "dev:email": "email dev --dir src/email",
    "lint": "biome check src",
    "start": "next start",
    "stripe:listen": "stripe listen --forward-to 127.0.0.1:3000/api/webhooks/stripe",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:update": "playwright test --config playwright.config.ts --update-snapshots",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@safrs/api": "workspace:*",
    "@safrs/database": "workspace:*",
    "@safrs/env": "workspace:*",
    "@safrs/telemetry": "workspace:*",
    "@safrs/ui": "workspace:*",
    "@sentra/token": "workspace:*",
    "hono": "4.13.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.19.0",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "@safrs/config": "workspace:*",
    "@playwright/test": "1.62.1",
    "@react-email/ui": "6.9.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.13",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react-email": "6.9.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
