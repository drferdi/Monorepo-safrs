{
  "name": "@safrs/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./reset-guard": "./src/reset-guard.ts"
  },
  "scripts": {
    "generate": "node --experimental-strip-types scripts/run-local-prisma.mjs generate",
    "migrate": "node --experimental-strip-types scripts/run-local-prisma.mjs migrate",
    "seed": "node --experimental-strip-types scripts/run-local-prisma.mjs seed",
    "reset": "node --experimental-strip-types src/reset.ts",
    "studio": "node --experimental-strip-types scripts/run-local-prisma.mjs studio",
    "lint": "biome check src/client.ts src/index.ts src/local-tooling.ts src/local-tooling.test.ts src/reset-guard.ts src/reset-guard.test.ts src/reset.ts src/seed.ts src/seed.integration.test.ts prisma.config.ts scripts/run-local-prisma.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@safrs/env": "workspace:*",
    "@safrs/telemetry": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@safrs/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
