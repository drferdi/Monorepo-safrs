{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/biome-after-edit.mjs"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "node .cursor/hooks/biome-after-edit.mjs"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-shell.mjs",
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/guard-read-secrets.mjs",
        "failClosed": true
      }
    ]
  }
}
