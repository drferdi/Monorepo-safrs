{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  // Cakupan pemindaian mengikuti .gitignore: apa pun yang tidak dilacak Git
  // (state editor lokal, artefak agen, cache) bukan sumber kanonik dan tidak
  // boleh menentukan hasil `pnpm lint`.
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Sisa pengecualian di bawah ini dilacak Git tetapi bukan sumber kanonik.
      // Kontrol plane SAFRS dan cache Turbo: dihasilkan mesin.
      "!!**/.safrs",
      "!!**/.turbo",
      // Keluaran build dan verifikasi Next.js/Playwright.
      "!!**/.next",
      "!!**/next-env.d.ts",
      "!!**/playwright-report",
      "!!**/test-results",
      // Transkrip alat pihak ketiga.
      "!!**/.specstory",
      // Profil agen (SOUL.md, skills pihak ketiga, template contoh): sumbernya
      // runtime Hermes, bukan repositori. Memformatnya membuat berkas di sini
      // menyimpang dari yang benar-benar dimuat agen.
      "!!projects/**/ai/profiles",
      // Knowledge package impor (integritas dijaga sha256 manifest, ADR 0003):
      // reformat = hash pecah. Bukan sumber kanonik formatter.
      "!!projects/academic/academic-smartboard/ai/kayyisa",
      // Snapshot HTML Webflow marketing (Sentra Bot): fidelity desain 100%;
      // JS/CSS inline minified tidak boleh di-lint/reformat Biome.
      "!!projects/product/sentrabot/apps/web/src/content/marketing",
      // Potongan markup Webflow situs Sentra Bot: fidelity desain 100%,
      // sejajar dengan apps/web/src/content/marketing.
      "!!projects/product/sentrabot/apps/site/src/html",
      // Vendor third-party minified (GSAP/ScrollTrigger) — bukan sumber kanonik.
      // Snapshot mentah situs asal (HTML Webflow, aset, dataset): arsip
      // provenance, bukan kode yang dirawat.
      "!!projects/product/sentrabot/apps/site/original",
      // Aset situs Sentra Bot hasil capture Webflow: berkas ber-nama hash
      // (js/css/webp/woff2 minified), keluaran bundler, bukan sumber kanonik.
      "!!projects/product/sentrabot/apps/site/**/assets",
      "!!projects/product/sentrabot/apps/site/src/vendor",
      // Portfolio capture + vendored Lenis/React — bukan sumber kanonik formatter.
      // Halaman portfolio memuat widget pihak ketiga (OpenWidget) minified
      // secara inline; bukan sumber kanonik formatter.
      "!!projects/*/portfolio*/**/index.html",
      "!!projects/*/portfolio*/**/vendor",
      "!!projects/*/portfolio*/**/assets",
      "!!projects/*/portfolio*/**/styles",
      "!!projects/*/portfolio*/**/src/portfolio-markup.js",
      // Skema/migrasi database dan dokumentasi impor: format asing.
      "!!database",
      "!!docs/design-system",
      "!!docs/brand",
      // Klien Prisma hasil generate.
      "!!packages/database/src/generated/prisma"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
